# Template for Supabase Edge Function secrets for the BD CRM.
# Copy to .env.functions.local (already gitignored — see project .gitignore),
# fill in real values, then run:
#   supabase secrets set --env-file supabase/.env.functions.local
#
# Never commit .env.functions.local. The BREVO_API_KEY must never reach the
# browser -- it is only ever read inside Edge Functions via Deno.env.get().

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Stephanie Marchesseau
BREVO_REPLY_TO_EMAIL=

# Seeds bd_settings.daily_send_limit on first deploy only. After that, the
# enforced daily limit lives in bd_settings (editable from the CRM Settings
# screen) — changing this variable later does nothing on its own.
BD_DAILY_SEND_LIMIT=20

# Master safety switch. Must be the literal string "true" to allow any real
# (non-test) send. Keep as "false" until you are ready to send live email.
BD_REAL_EMAIL_SENDING_ENABLED=false

# The one CRM owner account. Must match the email of the Supabase Auth user
# you create for yourself (see supabase/BD_CRM_SETUP.md). Also hardcoded as
# the fallback in supabase/functions/_shared/auth.ts and in the
# public.bd_is_owner() SQL function -- if you ever change this address you
# must update both places too.
BD_OWNER_EMAIL=marchesseau.stephanie@gmail.com

# Optional: only needed if you enable the Brevo webhook function.
BD_WEBHOOK_SECRET=
